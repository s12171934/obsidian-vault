# 로컬 전용 도메인 — 이 환경의 작업·자동화 배치·지식·이력. 각 도메인의 rules/ 만 추적한다
/10_Projects/*
!/10_Projects/rules/
/30_Automations/*
!/30_Automations/rules/
/50_Knowledge/*
!/50_Knowledge/rules/
/CHANGE_LOG.md

# 기기별 앱 설정 (플러그인 data.json 에 자격증명이 들어갈 수 있음)
/.obsidian/

# 로컬 스킬 목록 — 외부(npx skills)·로컬 전용 스킬은 무시. 내 스킬은 git submodule add -f 로 추적
/20_Agents/skills/*

# R2 업로드 전 임시 버퍼
/Attachments/

# 이관 임시 보관 — 결정 대기 문서·자동화 (비우면 폴더째 지운다)
/temp/

# 기기마다 다시 생기는 산출물 — 파이썬 버전이 다른 기기끼리 서로 덮어쓰지 않게 한다
__pycache__/
/.playwright-mcp/

.DS_Store
.trash/
